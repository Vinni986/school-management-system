{% extends 'school/staff_layout.html' %}
{% block school_content %}
<div class="school-hero"><div><small>STUDENT PROFILE</small><h1>{{ student.student.get_full_name }}</h1><p>{{ student.student.username }}{% if enrollment %} • {{ enrollment.section.grade.name }} - Section {{ enrollment.section.name }}{% endif %}</p></div></div>
<div class="metric-grid"><div class="metric-card purple"><small>Assessments</small><strong>{{ attempts|length }}</strong><span>Recent completed</span></div><div class="metric-card orange"><small>Open gaps</small><strong>{{ gaps|length }}</strong><span>Need attention</span></div><div class="metric-card green"><small>Mastered concepts</small><strong>{{ performances|length }}</strong><span>Tracked concepts</span></div></div>
<section class="school-panel"><div class="panel-head"><div><h2>Learning gaps</h2><p>Teacher/principal can review and assign remedial resources.</p></div></div>{% for gap in gaps %}<div class="list-row"><div><b>{{ gap.concept.title }}</b><small>{{ gap.concept.chapter.subject.name }} • gap {{ gap.gap_score }}%</small></div>{% if teacher_view %}{% for resource in resources %}{% if resource.concept_id == gap.concept_id %}<form method="post" action="{% url 'school_teacher_assign_remedial' gap.pk %}" style="margin:0">{% csrf_token %}<input type="hidden" name="resource_id" value="{{ resource.pk }}"><button class="school-btn small" type="submit">Assign remedial</button></form>{% endif %}{% endfor %}{% endif %}</div>{% empty %}<p class="empty">No open gaps.</p>{% endfor %}</section>
<section class="school-panel"><div class="panel-head"><div><h2>Assessment history</h2></div></div><div class="table-wrap"><table><thead><tr><th>Assessment</th><th>Subject</th><th>Score</th><th>Date</th></tr></thead><tbody>{% for a in attempts %}<tr><td>{{ a.assessment.title }}</td><td>{{ a.assessment.subject.name }}</td><td><b>{{ a.percentage }}%</b></td><td>{{ a.completed_at|date:'d M Y' }}</td></tr>{% empty %}<tr><td colspan="4" class="empty">No attempts yet.</td></tr>{% endfor %}</tbody></table></div></section>
{% endblock %}
